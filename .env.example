# Copy to .env and adjust as needed. Values in docker-compose.yml take
# precedence; this file documents every supported variable.

# ---- Backend ---------------------------------------------------------------
PORT=8080
# Host is `db` inside docker compose; use `localhost` when running outside Docker.
DATABASE_URL=postgres://marketplace:marketplace@db:5432/marketplace?sslmode=disable
JWT_SECRET=change-me-in-production
JWT_TTL_HOURS=168

# Storage: minio (S3-compatible) or local (disk under ./data/uploads)
STORAGE_PROVIDER=minio
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=laptop-images
S3_PUBLIC_URL=http://localhost:9000
LOCAL_UPLOAD_DIR=./data/uploads

# CORS / limits
FRONTEND_ORIGIN=http://localhost:3000
RATE_LIMIT_PER_MINUTE=120

# Browser-reachable base URL of the API (used for seeded placeholder images)
PUBLIC_BASE_URL=http://localhost:8080

# Seed demo users + listings on first boot
SEED=true

# ---- Frontend --------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080